{
  "name": "voxel-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:server && concurrently -k -n api,types,web \"node --watch dist-server/server/main.js\" \"tsc -p server/tsconfig.json --watch\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "npm run build:server && node --watch dist-server/server/main.js",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build && npm run build:server",
    "start": "node dist-server/server/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "test:api": "node --test tests/api.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:frontend": "node --test tests/frontend.test.mjs",
    "test:frontend:browser": "node tests/frontend-browser.mjs",
    "test:world": "npm run build:server && node --experimental-transform-types --test tests/world.test.mjs",
    "test:world:service": "npm run build:server && node --test tests/world-service.test.mjs",
    "test:world:browser": "node --experimental-transform-types tests/world-browser.mjs",
    "test:modes:browser": "node tests/modes-browser.mjs",
    "test:survival": "npm run build:server && node --experimental-transform-types --test tests/survival.test.mjs",
    "test:survival:browser": "node tests/survival-browser.mjs",
    "test:inventory:browser": "node tests/inventory-browser.mjs",
    "test:ux:browser": "node --experimental-transform-types tests/ux-browser.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide": "^0.468.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "three": "^0.180.0",
    "zod": "^3.25.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prisma": "^6.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
